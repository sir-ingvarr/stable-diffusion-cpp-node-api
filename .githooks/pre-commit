#!/bin/sh
# Runs the full test suite (unit + functional) before each commit.
#
# The functional suite needs a local diffusion model: set SD_NODE_MODEL_PATH,
# or answer the prompt (press Enter to skip the functional tests).
# Optional: SD_NODE_ESRGAN_MODEL_PATH enables the upscaler tests.
#
# Bypass for a single commit:  git commit --no-verify   (or SKIP_TESTS=1)
# Install:                     npm run hooks:install

[ "$SKIP_TESTS" = "1" ] && exit 0

echo "pre-commit: running tests (skip with --no-verify or SKIP_TESTS=1)"
exec npm test
